font-family = "Monocraft Nerd Font"
font-size = 18
adjust-cell-height = 10%
font-feature = -calt
font-feature = -clig
font-feature = -liga
background-opacity = 0.7
background-blur-radius = 15
window-decoration = auto
macos-titlebar-style = hidden
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = false
cursor-color = #e4f6f9
window-padding-color = extend
window-padding-balance = true
palette = 0=#183838
palette = 1=#e8837c
palette = 2=#7cc4a4
palette = 3=#d8c88f
palette = 4=#5bb0cc
palette = 5=#9aa8f0
palette = 6=#6fbfc0
palette = 7=#cfe6ea
palette = 8=#5f8a94
palette = 9=#e8837c
palette = 10=#7cc4a4
palette = 11=#d8c88f
palette = 12=#80b8e8
palette = 13=#9aa8f0
palette = 14=#a8d4f0
palette = 15=#e4f6f9
background = #07141a
foreground = #cfe6ea
cursor-color = #e4f6f9
selection-background = #22505c
selection-foreground = #e4f6f9
keybind = alt+backspace=text:\x17
keybind = super+backspace=text:\x15
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = super+d=scroll_page_down
keybind = super+u=scroll_page_up
focus-follows-mouse = true
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
