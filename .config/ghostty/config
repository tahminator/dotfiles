font-family = "ProggyClean Nerd Font"
font-size = 18
adjust-cell-height = 10%
font-feature = -calt
font-feature = -clig
font-feature = -liga
background-opacity = 0.7
background-blur-radius = 0
# Borderless window: no titlebar and square corners (titlebar-style keeps them round).
window-decoration = none
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = false
theme = mono
window-padding-color = extend
window-padding-balance = true
keybind = alt+backspace=text:\x17
keybind = super+backspace=text:\x15
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = super+d=scroll_page_down
keybind = super+u=scroll_page_up
focus-follows-mouse = true
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
